{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["baragoon"],
  "configMigration": true,
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "(?<depName>ghcr\\.io/baragoon/whoami):(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "versioningTemplate": "semver"
    }
  ],
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "forkProcessing": "enabled",
  "packageRules": [
    {
      "groupName": "go dependencies",
      "matchDepTypes": [
        "indirect",
        "require"
      ],
      "matchManagers": [
        "gomod"
      ]
    },
    {
      "groupName": "golang version",
      "groupSlug": "golang-version",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "golang"
      ],
      "separateMinorPatch": true,
      "separateMultipleMinor": true
    },
    {
      "groupName": "golang version",
      "groupSlug": "golang-version",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "go"
      ],
      "rangeStrategy": "bump",
      "separateMinorPatch": true,
      "separateMultipleMinor": true
    },
    {
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "ghcr.io/baragoon/whoami"
      ],
      "pinDigests": false
    }
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ]
}
